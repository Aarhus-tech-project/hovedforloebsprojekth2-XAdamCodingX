@page "/"

<MudText Typo="Typo.h4" GutterBottom="true">Arena Stats</MudText>
<MudText Typo="Typo.subtitle1" Class="mb-4" Style="color:#aaa">Arena Season 2 — Europe & North America</MudText>

<MudGrid>
    <MudItem xs="3">
        <MudPaper Class="pa-4" Style="background:#1a1a2e;color:white">
            <MudText Typo="Typo.caption" Style="color:#aaa">MATCHES</MudText>
            <MudText Typo="Typo.h4">44</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="3">
        <MudPaper Class="pa-4" Style="background:#1a1a2e;color:white">
            <MudText Typo="Typo.caption" Style="color:#aaa">HEROES TRACKED</MudText>
            <MudText Typo="Typo.h4">31</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="3">
        <MudPaper Class="pa-4" Style="background:#1a1a2e;color:white">
            <MudText Typo="Typo.caption" Style="color:#aaa">MAPS IN POOL</MudText>
            <MudText Typo="Typo.h4">17</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="3">
        <MudPaper Class="pa-4" Style="background:#1a1a2e;color:white">
            <MudText Typo="Typo.caption" Style="color:#aaa">REGIONS</MudText>
            <MudText Typo="Typo.h4">2</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid Class="mt-4">
    <MudItem xs="4">
        <MudPaper Class="pa-4" Style="background:#1a1a2e;color:white">
            <MudText Typo="Typo.h6" Class="mb-2">Quick links</MudText>
            <MudNavLink Href="/heroes" Style="color:#f97316">⚔ Hero Stats →</MudNavLink>
            <MudNavLink Href="/maps" Style="color:#38bdf8">🗺 Map Stats →</MudNavLink>
            <MudNavLink Href="/matches" Style="color:#4ade80">📋 Match Browser →</MudNavLink>
        </MudPaper>
    </MudItem>
    <MudItem xs="8">
        <MudPaper Class="pa-4" Style="background:#1a1a2e;color:white">
            <MudText Typo="Typo.h6" Class="mb-2">Top 3 most picked</MudText>
            <MudText Style="color:#aaa">Brigitte · Junker Queen · Soldier: 76</MudText>
            <MudText Typo="Typo.h6" Class="mt-3 mb-2">Top 3 most banned</MudText>
            <MudText Style="color:#aaa">Freja · Mercy · Junker Queen</MudText>
            <MudText Typo="Typo.h6" Class="mt-3 mb-2">Most played map</MudText>
            <MudText Style="color:#aaa">Throne of Anubis (28 times)</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>